# Copy to .env and fill in.
PORT=3000
DC_VM_NAME=instance-1
DC_VM_ZONE=
DC_VM_PROJECT=your-gcp-project-id
# e.g. --tunnel-through-iap; add --strict-host-key-checking=no if you lack compute.instances.getGuestAttributes
DC_SSH_FLAGS=
# Optional; if empty the UI asks for it
DC_PG_PASSWORD=
# Where payload JSON files are saved (default: ../payloads)
DC_OUT_DIR=
# Default parallel SSH sessions (1-8); changeable in the UI (saved to data/settings.json)
DC_SESSIONS=4
# Default automatic retries for transient create-quote errors (deadlock, E012, 502-504); changeable in the UI
DC_AUTO_RETRIES=2
# Per-job timeout; on timeout the SSH session is restarted
DC_TIMEOUT_SECONDS=180
DC_CONNECT_TIMEOUT_SECONDS=90
# true = this server runs ON the VM; skip gcloud ssh
DC_LOCAL=false

# --- Environment-specific: required ---
# Directory on the VM to cd into (holds the psql SSL cert/key files)
DC_WORK_DIR=/home/<user-with-certs>
# create-quote wrapper endpoint (reachable from the VM)
DC_CREATE_QUOTE_URL=https://<wrapper-host>/wrapper/create-quote
# libpq connection string used by psql on the VM (password comes from the UI or DC_PG_PASSWORD)
DC_PG_CONN=sslmode=verify-ca sslrootcert=<server-ca>.pem sslcert=<client-cert>.pem sslkey=<client-key>.pem hostaddr=<db-host> port=5432 user=<db-user> dbname=<db-name>
# Schema-qualified table holding external_request / external_response
DC_API_LOGS_TABLE=<schema>.api_logs
